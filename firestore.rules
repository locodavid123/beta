rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function settingsExist() {
      return exists(/databases/$(database)/documents/system/settings);
    }

    function publicRegistrationEnabled() {
      return !settingsExist()
        || get(/databases/$(database)/documents/system/settings).data.publicRegistration != false;
    }

    function maintenanceDisabled() {
      return !settingsExist()
        || get(/databases/$(database)/documents/system/settings).data.maintenanceMode != true;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true
        && (!settingsExist()
          || get(/databases/$(database)/documents/system/settings).data.maintenanceMode != true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'root']);
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'root'];
    }

    function isRoot() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'root';
    }

    match /styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /creations/{creationId} {
      allow read: if isAdmin()
        || (activeUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email;
      allow update: if isAdmin()
        || (activeUser()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin()
        || (activeUser() && resource.data.ownerUid == request.auth.uid);
    }

    match /pets/{petId} {
      allow read: if isAdmin()
        || (activeUser() && resource.data.userEmail == request.auth.token.email);
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email;
      allow update: if isAdmin()
        || (activeUser()
          && resource.data.userEmail == request.auth.token.email
          && request.resource.data.userEmail == request.auth.token.email
          && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin()
        || (activeUser() && resource.data.userEmail == request.auth.token.email);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'client'
          && request.resource.data.credits == 5
          && publicRegistrationEnabled()
          && maintenanceDisabled())
        || (isAdmin()
          && request.resource.data.uid == userId
          && request.resource.data.role in ['client', 'admin', 'root']
          && (isRoot() || request.resource.data.role == 'client'));
      allow update: if isRoot()
        || (isAdmin()
          && resource.data.role == 'client'
          && request.resource.data.role == 'client')
        || (isOwner(userId)
          && activeUser()
          && request.resource.data.role == resource.data.role
          && request.resource.data.credits <= resource.data.credits
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'photoUrl',
            'isDarkMode',
            'language',
            'pushNotifications',
            'emailNotifications',
            'imageQuality',
            'favoriteTutorialIds',
            'completedTutorialIds',
            'credits',
            'lastLogin'
          ]));
      allow delete: if isRoot();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    match /system/{documentId} {
      allow read: if documentId == 'settings' || isRoot();
      allow write: if isRoot();
    }
  }
}
